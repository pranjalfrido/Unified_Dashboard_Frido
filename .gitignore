# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit
sa_key.json
*.json.key
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*

# Service-account keys under any filename — the bare `sa_key.json` rule above missed
# copies like "sa_key 1 (1).json" that download managers create.
sa_key*.json
*service-account*.json

# Ad-hoc analysis output (pincode extracts etc) — regenerate on demand, not source.
exports/

# Playwright-saved login session for the responsive-overhaul audit (scripts/save-auth.mjs) — a
# live auth credential, never commit it.
docs/responsive/.auth/

# Responsive-audit screenshots (docs/responsive/before|after/...) - large, regenerated by
# scripts/responsive/capture-screens.mjs; kept locally, never committed.
docs/responsive/**/*.png

# Parity-verification snapshots (scripts/parity-snapshot.mjs output) — regenerate on demand.
parity/

# alerts phase 2 headless P\&L scratch
.alerts-p2-tmp/

# Feedback feature: local-mode store (FEEDBACK_LOCAL=1) — test data and screenshots, never commit.
.feedback-local/
